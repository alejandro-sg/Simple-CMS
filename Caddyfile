# Replace api.your-domain.com with your actual API subdomain
api.your-domain.com {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy api:8080 {
        # Strip any client-supplied X-Forwarded-For so attackers cannot
        # spoof their IP to bypass rate limiters. Caddy then sets X-Real-IP
        # to the actual connecting socket IP, which chi's RealIP middleware
        # reads first.
        header_up -X-Forwarded-For
        header_up X-Real-IP {remote_host}
    }
}
