PORT=8080
CMS_DB_PATH=./cms.db

# Generate: htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=72

# S3 — leave blank to disable image uploads in local dev
S3_BUCKET=your-cms-images
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ISR revalidation (optional — only if you have a Next.js public site)
REVALIDATE_URL=https://your-site.vercel.app/api/revalidate
REVALIDATE_SECRET=

# Comma-separated CORS origins (add your admin UI URL)
ALLOWED_ORIGINS=http://localhost:3001,https://admin.your-domain.com

# AWS Secrets Manager (production only — uncomment and set to enable)
# AWS_SECRET_NAME=simple-cms/api

PREVIEW_SECRET=
WEBSITE_URL=https://your-domain.com
